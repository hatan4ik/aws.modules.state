run "key_replication_is_granted_on_replicated_primary_keys_to_the_key_administrators_only" {
  command = plan

  assert {
    condition = alltrue([
      for tier in ["staging", "prod"] : jsondecode(output.key_policies[tier]).Statement[2] == {
        Sid       = "KeyReplication"
        Effect    = "Allow"
        Action    = ["kms:ReplicateKey"]
        Resource  = "*"
        Principal = { AWS = ["arn:aws:iam::111122223333:role/key-admin"] }
      }
    ])
    error_message = "A replicated tier's primary key policy must allow exactly kms:ReplicateKey, to the key administrators only."
  }

  assert {
    condition = alltrue(flatten([
      for tier in ["dev", "staging", "prod"] : [
        for statement in jsondecode(output.key_policies[tier]).Statement :
        statement.Sid == "KeyReplication" || !contains(flatten([statement.Action]), "kms:ReplicateKey")
      ]
    ]))
    error_message = "kms:ReplicateKey must appear in the KeyReplication statement only, never in the use statement given to the state and replication roles."
  }

  assert {
    condition     = !strcontains(output.key_policies["dev"], "kms:ReplicateKey")
    error_message = "A non-replicated tier's key policy must not allow kms:ReplicateKey."
  }

  assert {
    condition = alltrue([
      for tier in ["staging", "prod"] : !strcontains(output.replica_key_policies[tier], "kms:ReplicateKey")
    ])
    error_message = "A replica key policy must not allow kms:ReplicateKey; only the primary key is replicated."
  }
}

run "key_replication_follows_every_key_administrator" {
  command = plan

  variables {
    key_administrator_arns = [
      "arn:aws:iam::111122223333:role/key-admin-b",
      "arn:aws:iam::111122223333:role/key-admin-a",
    ]
  }

  assert {
    condition     = jsondecode(output.key_policies["prod"]).Statement[2].Principal.AWS == jsondecode(output.key_policies["prod"]).Statement[0].Principal.AWS
    error_message = "KeyReplication must name exactly the principals of KeyAdministration."
  }

  assert {
    condition     = jsondecode(output.key_policies["prod"]).Statement[2].Principal.AWS == ["arn:aws:iam::111122223333:role/key-admin-a", "arn:aws:iam::111122223333:role/key-admin-b"]
    error_message = "KeyReplication principals must be rendered in a deterministic order."
  }
}
